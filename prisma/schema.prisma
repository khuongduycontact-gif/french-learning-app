generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Level {
  A1
  A2
  B1
  B2
  C1
}

enum EnrollmentStatus {
  PENDING_PAYMENT     // vừa đăng ký, đang chờ học viên thanh toán
  AWAITING_CONFIRMATION // học viên đã bấm "Tôi đã thanh toán", chờ admin xác nhận
  CONFIRMED            // admin đã xác nhận, khoá học được mở
}

enum NotificationType {
  PAYMENT_SUBMITTED    // gửi cho admin: học viên báo đã thanh toán
  ENROLLMENT_CONFIRMED // gửi cho học viên: admin đã xác nhận mở khoá học
  PAYMENT_REJECTED     // gửi cho học viên: admin từ chối xác nhận thanh toán
  SUBMISSION_RECEIVED  // gửi cho admin: học viên vừa nộp bài tập
  SUBMISSION_GRADED    // gửi cho học viên: admin đã chữa xong bài tập
  BOOK_PAYMENT_SUBMITTED  // gửi cho admin: người dùng báo đã thanh toán mua sách
  BOOK_PURCHASE_CONFIRMED // gửi cho người dùng: admin đã xác nhận mua sách thành công
  BOOK_PAYMENT_REJECTED   // gửi cho người dùng: admin từ chối xác nhận thanh toán mua sách
}

enum SubmissionStatus {
  SUBMITTED // học viên đã nộp, đang chờ admin chữa
  GRADED    // admin đã chữa và gửi lại bài cho học viên
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  role          Role           @default(USER)
  accounts      Account[]
  sessions      Session[]
  enrollments   Enrollment[]
  notifications Notification[]
  submissions   Submission[]     @relation("SubmissionsByStudent")
  gradedSubmissions Submission[] @relation("SubmissionsGradedByAdmin")
  submissionDeadlines SubmissionDeadline[]
  bookPurchases BookPurchase[]
  createdAt     DateTime       @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  level       Level        @default(A1)
  price       Int          @default(0)
  duration    Float        @default(0) // số giờ học/buổi học, cho phép lẻ (VD: 1.5 = 1 giờ 30 phút)
  sessions    Int          @default(0) // số buổi học (không còn nhập ở form quản trị, giữ lại cho dữ liệu cũ)
  lessons     Int          @default(0) // số bài giảng
  // Số bài học (CourseMaterial) đầu tiên (theo `order`) được xem miễn phí,
  // không cần đăng ký khoá học. Admin tự đặt tuỳ ý (0 = không có bài nào
  // miễn phí, giữ nguyên hành vi cũ). Học viên xem hết số bài miễn phí này
  // rồi thì phải đăng ký (enrollment CONFIRMED) mới xem tiếp được các bài
  // sau. Giá trị luôn được so khớp (min) với số bài học thực tế khi hiển thị,
  // để lỡ admin đặt số lớn hơn số bài học hiện có cũng không gây lỗi.
  freeLessons Int          @default(0)
  videoUrl    String?      @db.Text // ảnh hoặc video giới thiệu, lưu trên Cloudinary
  published   Boolean      @default(true)
  enrollments Enrollment[]
  materials   CourseMaterial[]
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Thời khoá biểu: 1 buổi học (ca học) cụ thể của 1 lớp học, tại 1 mốc
// ngày giờ cụ thể. Học viên không bắt buộc phải có tài khoản (User) trong
// hệ thống - admin tự nhập tên lớp/gmail để linh hoạt xếp lịch cho cả học
// viên tiềm năng, nên lưu trực tiếp className/studentEmails thay vì bắt
// buộc liên kết User. 1 lớp có thể có nhiều học viên, mỗi học viên 1 gmail
// -> studentEmails lưu danh sách gmail cách nhau bởi dấu phẩy (","), gửi
// mail nhắc lịch cho toàn bộ danh sách này trong cùng 1 lần gửi. Số thứ tự
// "ca học" trong ngày (1, 2, 3...) được tính động phía server/client theo
// thứ tự thời gian trong ngày, không lưu cứng trong DB để không bị lệch
// khi thêm/xoá/sửa các ca khác trong cùng ngày.
model StudentSchedule {
  id             String    @id @default(cuid())
  // Tên lớp (VD: "Pháp Ngữ Trung Cấp B1"). Admin gõ trực tiếp, không chọn
  // từ danh sách khoá học trên web.
  className      String
  // Danh sách gmail của các học viên trong lớp, cách nhau bởi dấu phẩy.
  studentEmails  String    @db.Text
  startTime      DateTime // mốc ngày giờ bắt đầu buổi học
  duration       Float     @default(1.5) // số giờ học của buổi này, cho phép lẻ (VD: 1.5 = 1 giờ 30 phút)
  note           String?   @db.Text
  // Buổi học này do 1 "lịch lặp hàng tuần" (RecurringSchedule) tự sinh ra thì
  // sẽ có recurringId trỏ tới rule đó; buổi tạo thủ công (1 lần) thì để NULL.
  recurringId    String?
  // Mốc thời gian đã gửi mail nhắc lịch (8 tiếng trước giờ học) cho buổi này,
  // NULL nghĩa là chưa gửi. Dùng để cron không gửi trùng 2 lần cho 1 buổi.
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recurring RecurringSchedule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, startTime])
  @@index([startTime])
  @@index([recurringId])
}

// "Lịch lặp hàng tuần": 1 rule để tự động sinh ra nhiều buổi học
// (StudentSchedule) lặp lại đúng 1 khung giờ mỗi tuần, không giới hạn số
// tuần (endDate = NULL). Các buổi cụ thể được sinh dần ra trước một
// khoảng thời gian (xem src/lib/recurringSchedule.ts), không sinh sẵn vô
// hạn bản ghi trong DB. Việc sửa/xoá từng buổi cụ thể vẫn thao tác trên
// StudentSchedule như bình thường; xoá/dừng ở đây chỉ ảnh hưởng tới các
// buổi *sắp* được sinh thêm trong tương lai.
model RecurringSchedule {
  id             String    @id @default(cuid())
  // Tên lớp, xem giải thích ở StudentSchedule.className.
  className      String
  // Danh sách gmail của các học viên trong lớp, xem giải thích ở
  // StudentSchedule.studentEmails.
  studentEmails  String    @db.Text
  startTime      DateTime // buổi học đầu tiên - thứ trong tuần + giờ/phút của mốc này là khung giờ lặp lại mỗi tuần
  duration       Float     @default(1.5)
  note           String?   @db.Text
  endDate        DateTime? // NULL = lặp lại không giới hạn (vô thời hạn)
  active         Boolean   @default(true) // false = đã dừng lặp, không sinh thêm buổi mới nữa
  generatedUntil DateTime // đã sinh buổi cụ thể tới hết mốc này rồi, dùng để sinh tiếp mà không bị trùng
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedules StudentSchedule[]

  @@index([active])
}

model CourseMaterial {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  description String?  @db.Text
  files       Json     // Danh sách tệp đính kèm: [{ url, type, name }]
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
  deadlines   SubmissionDeadline[]

  @@index([courseId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(PENDING_PAYMENT)
  paidAmount  Int              @default(0)
  paymentNote String?          // nội dung chuyển khoản để đối chiếu (VietQR addInfo)
  confirmedAt DateTime?        // thời điểm admin xác nhận mở khoá
  createdAt   DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Sách/truyện: nội dung là 1 tệp PDF duy nhất (contentUrl). Giống Course,
// giá = 0 nghĩa là miễn phí (đọc được ngay), giá > 0 thì phải mua (qua
// BookPurchase, tái dùng đúng luồng thanh toán VietQR + admin xác nhận
// giống Enrollment của khoá học).
model Book {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  coverImage  String?        @db.Text // ảnh bìa sách, lưu trên Cloudinary
  contentUrl  String         @db.Text // tệp PDF nội dung sách, lưu trên Cloudinary
  description String         @db.Text
  price       Int            @default(0)
  published   Boolean        @default(true)
  purchases   BookPurchase[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Website học tiếng Pháp uy tín - admin thêm/sửa/xoá, hiển thị dạng slider
// tự động ở trang chủ (giống cách hiển thị Sách), bấm vào ảnh sẽ mở link
// sang tab mới.
model TrustedWebsite {
  id          String   @id @default(cuid())
  name        String
  coverImage  String?  @db.Text // ảnh bìa website, lưu trên Cloudinary
  link        String   @db.Text // đường dẫn tới website
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lượt mua sách - tái dùng đúng enum EnrollmentStatus (PENDING_PAYMENT ->
// AWAITING_CONFIRMATION -> CONFIRMED) vì luồng thanh toán/xác nhận giống
// hệt lượt đăng ký khoá học.
model BookPurchase {
  id          String           @id @default(cuid())
  userId      String
  bookId      String
  status      EnrollmentStatus @default(PENDING_PAYMENT)
  paidAmount  Int              @default(0)
  paymentNote String?          // nội dung chuyển khoản để đối chiếu (VietQR addInfo)
  confirmedAt DateTime?        // thời điểm admin xác nhận đã nhận thanh toán
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// Bài tập học viên nộp cho một tài liệu bài tập (CourseMaterial) cụ thể,
// thuộc một khoá học cụ thể -> admin luôn biết chính xác cần chữa bài nào,
// của khoá học nào (mỗi học viên chỉ có 1 bản nộp cho mỗi tài liệu, nộp lại
// sẽ ghi đè và chuyển về trạng thái chờ chữa).
model Submission {
  id          String           @id @default(cuid())
  courseId    String
  materialId  String
  userId      String
  files       Json             // Tệp học viên nộp: [{ url, name, type }]
  note        String?          @db.Text // Ghi chú của học viên khi nộp bài
  status      SubmissionStatus @default(SUBMITTED)
  gradedFiles Json?            // Tệp admin đã chữa gửi lại: [{ url, name, type }]
  gradedNote  String?          @db.Text // Nhận xét của admin khi chữa bài
  gradedById  String?          // Admin nào đã chữa
  gradedAt    DateTime?
  submittedAt DateTime         @default(now()) // Lần nộp (hoặc nộp lại) gần nhất
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User           @relation("SubmissionsByStudent", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy User?          @relation("SubmissionsGradedByAdmin", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([userId, materialId])
  @@index([courseId])
  @@index([materialId])
  @@index([userId])
  @@index([gradedById])
}

// Đếm giờ nộp bài: được tạo ra ngay khi học viên tải/xem tài liệu bài tập
// (CourseMaterial, nhóm "exercise") lần đầu tiên. Từ thời điểm startedAt,
// học viên có đúng `hours` giờ (mặc định 48) để nộp bài; quá hạn thì tính
// năng nộp bài cho tài liệu đó bị khoá cho đến khi admin mở khoá lại (đặt
// lại startedAt = thời điểm hiện tại).
model SubmissionDeadline {
  id         String   @id @default(cuid())
  materialId String
  userId     String
  startedAt  DateTime @default(now()) // mốc bắt đầu đếm giờ (tải lần đầu, hoặc admin đặt lại)
  hours      Int      @default(48) // số giờ được phép nộp bài kể từ startedAt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId])
}

model Achievement {
  id           String   @id @default(cuid())
  level        Level // Trình độ đạt được
  studentName  String // Tên học viên
  evidenceUrl  String   @db.Text // Ảnh minh chứng (Cloudinary)
  thankYouUrls Json // Danh sách ảnh lời cảm ơn của học viên (Cloudinary): ["url1", "url2", ...]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([level])
}

// Trang "Giới thiệu về tôi" (Céline) - chỉ có đúng 1 bản ghi (id cố định
// "main"). Các mục dạng danh sách (hành trình, lý do chọn học, thành tích,
// phương pháp giảng dạy, chứng chỉ, đánh giá học viên) được lưu dưới dạng
// Json để admin có thể thêm/sửa/xoá/sắp xếp tự do từ 1 trang quản trị duy
// nhất, không cần bảng riêng cho từng loại mục.
model AboutPage {
  id String @id @default("main")

  // --- Khối giới thiệu đầu trang (hero) ---
  heroKicker      String @default("Apprendre, c'est grandir")
  heroTitle       String @default("Giới thiệu về tôi")
  heroGreeting    String @default("Bonjour ! Mình là Céline.")
  heroDescription String @db.Text
  heroImageUrl    String? @db.Text

  // --- Hành trình của tôi (timeline mốc năm) ---
  // [{ id, year, icon, title, description }]
  timeline Json

  // --- Vì sao học cùng Céline (4 lý do) ---
  // [{ id, icon, title, description }]
  reasons Json

  // --- Phương pháp giảng dạy ---
  methodTitle    String  @default("Phương pháp giảng dạy")
  methodImageUrl String? @db.Text
  // [{ id, title, description }]
  methods Json

  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           // người nhận thông báo
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
